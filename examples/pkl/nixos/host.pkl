// A NixOS system in Pkl: the same one as host.nix (see default.nix).
amends "nixos.pkl"
import "nix:pkgs" as pkgs
import "nix:config" as config
import "nix:lib" as lib

networking {
  hostName = "pkl-demo"
  firewall { allowedTCPPorts { 22; 80; 443 } }
}
time { timeZone = "Europe/Amsterdam" }
users {
  users {
    ["alice"] {
      isNormalUser = true
      description = "Alice"
      extraGroups { "wheel"; "networkmanager" }
    }
  }
}
environment {
  // Packages: from pkgs, or as attribute paths in it.
  systemPackages {
    pkgs.htop; pkgs.git; "python3Packages.requests"
    // Calls of Nix functions: their results when they go back to Nix; `.text` now.
    pkgs.writeShellScriptBin.call("greet").call("exec \(lib.getExe.call(pkgs.hello).text) --greeting hi")
  }
  // Set to empty, unlike unset: none of NixOS's default packages (nano, perl, rsync, strace).
  defaultPackages {}
  // The configuration's values, as NixOS has them (its defaults, other modules' definitions).
  etc { ["motd"] { text = "Welcome to \(config.networking.hostName), NixOS \(config.system.nixos.release)" } }
}
services {
  openssh {
    enable = true
    settings { PermitRootLogin = "no"; PasswordAuthentication = false }
  }
  nginx {
    enable = true
    virtualHosts { ["example.org"] { root = "/var/www" } }
  }
}
// nginx's unit sets ProtectSystem = "strict": a definition of the same priority would conflict.
systemd { services { ["nginx"] { serviceConfig { ["ProtectSystem"] = module.mkForce("full") } } } }
fileSystems { ["/"] { device = "/dev/sda1"; fsType = "ext4" } }
boot { loader { grub { device = "/dev/sda" } } }
system { stateVersion = "25.11" }
