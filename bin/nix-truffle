#!/usr/bin/env bash
# Run the Truffle Nix interpreter: installed (the flake's package), or in a checkout built with
# mvn -q package. Java is $NIX_TRUFFLE_JAVA, $JAVA_HOME/bin/java or java (a GraalVM: the flake's
# package sets it). With NIX_TRUFFLE_DAEMON=1, commands run in a background daemon that keeps
# parsed and compiled code warm (see src/main/java/nixtruffle/launcher/Client.java);
# `nix-truffle daemon stop` stops it.
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ -f "$root/share/nix-truffle/nix-truffle.jar" ]]; then
  classes="$root/share/nix-truffle/nix-truffle.jar"
  deps="$(cat "$root/share/nix-truffle/classpath")"
elif [[ -f "$root/target/classpath.txt" ]]; then
  classes="$root/target/classes"
  deps="$(cat "$root/target/classpath.txt")"
else
  echo "nix-truffle: not built yet, run 'mvn -q package' in $root" >&2
  exit 1
fi
java="${NIX_TRUFFLE_JAVA:-}"
if [[ -z "$java" ]]; then
  java=java
  [[ -n "${JAVA_HOME:-}" ]] && java="$JAVA_HOME/bin/java"
  java="$(command -v "$java" || echo "$java")"
fi
# Compact object headers (8 instead of 12 bytes) take a third off the memory of large evaluations.
# Compiled Nix code outgrows the default 240 MB code cache, and then every few seconds HotSpot runs
# a full collection (half a second on a NixOS evaluation's heap) to unload compiled code.
# The heap may grow to three quarters of the memory (or of the cgroup's limit): the JVM's default,
# a quarter, is too little for a large evaluation on a small machine. But at most 30 GB: above
# that, references take 8 bytes instead of 4, and an evaluation takes half as much memory again.
# The collectors below keep the heap near what is live.
memory="$(awk '/^MemTotal:/ { print $2 * 1024 }' /proc/meminfo 2>/dev/null || sysctl -n hw.memsize 2>/dev/null || true)"
limit="$(cat /sys/fs/cgroup/memory.max 2>/dev/null || true)"
[[ "$limit" =~ ^[0-9]+$ && ( -z "$memory" || "$limit" -lt "$memory" ) ]] && memory="$limit"
heap=()
if [[ "$memory" =~ ^[0-9]+$ ]]; then
  mb=$((memory / 1024 / 1024 * 3 / 4))
  heap=("-Xmx$((mb < 30720 ? mb : 30720))m")
fi
jvm=(--enable-native-access=ALL-UNNAMED --sun-misc-unsafe-memory-access=allow -Dpolyglot.engine.WarnInterpreterOnly=true
  -XX:+UseCompactObjectHeaders -XX:ReservedCodeCacheSize=512m "${heap[@]}" ${NIX_TRUFFLE_JAVA_OPTS:-})
cp="$classes:$deps"
# One evaluation runs fastest, in the least memory, with the throughput collector holding the heap
# to about five times the time spent collecting (half of G1's memory on a NixOS evaluation, and
# 8% faster). The daemon uses G1 (see Client.java), which gives memory back between commands.
# What survives a young collection mostly lives until the end (the thunks and values evaluation
# keeps), so it goes to the old generation at once instead of being copied between survivor
# spaces, and collections use all cores (the default leaves 9 of 32 idle). Both together with the
# code cache: 5% faster in 7% less memory on one core, 15% faster in 28% less with eval-cores 8.
gc=()
[[ "${NIX_TRUFFLE_JAVA_OPTS:-}" == *GC* ]] || gc=(-XX:+UseParallelGC -XX:GCTimeRatio=4 -XX:MaxTenuringThreshold=0
  "-XX:ParallelGCThreads=$(nproc)")
if [[ "${NIX_TRUFFLE_DAEMON:-}" == 1 ]]; then
  # The client is a small JVM that only relays: no JIT beyond C1, the smallest GC.
  exec "$java" -XX:TieredStopAtLevel=1 -XX:+UseSerialGC -XX:-UsePerfData -cp "$classes" \
    nixtruffle.launcher.Client "$java" "${#jvm[@]}" "${jvm[@]}" "$cp" "$@"
fi
exec "$java" "${gc[@]}" "${jvm[@]}" -cp "$cp" nixtruffle.launcher.Main "$@"
